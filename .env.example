# Sem estas variáveis o app roda em modo demonstração, com dados de exemplo e sem servidor.
# Copie para .env.local e preencha com a configuração do app Web do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Opcional: aponta para os emuladores locais (npm run serve em functions/).
EXPO_PUBLIC_USE_EMULATORS=
